ryY=0;" edge="1" parent="1" source="c67" target="c88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=0.5;exitY=1;entryX=0.7887700534759359;entryY=0;" edge="1" parent="1" source="c74" target="c88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c117" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=0.5;exitY=1;entryX=0.9331550802139037;entryY=0;" edge="1" parent="1" source="c81" target="c88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c118" value="" style="rounded=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1" height="1" as="geometry"/></mxCell><mxCell id="c119" value="" style="text;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1" height="1" as="geometry"/></mxCell><mxCell id="c120" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1390" y="1244" width="1" height="1" as="geometry"/></mxCell><mxCell id="c121" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1470" y="1244" width="1" height="1" as="geometry"/></mxCell><mxCell id="c122" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;" edge="1" parent="1" source="c120" target="c121"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c123" value="Asosiasi" style="text;html=0;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1490" y="1232" width="120" height="24" as="geometry"/></mxCell><mxCell id="c124" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1390" y="1274" width="1" height="1" as="geometry"/></mxCell><mxCell id="c125" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1470" y="1274" width="1" height="1" as="geometry"/></mxCell><mxCell id="c126" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="c124" target="c125"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c127" value="Ketergantungan" style="text;html=0;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1490" y="1262" width="140" height="24" as="geometry"/></mxCell><mxCell id="c128" value="• User adalah data akun (tabel users): id, nama, email, no. telepon, password (hash), dan role (pengguna atau admin). Method verifikasiPassword() dipakai saat login.&#xa;• Produk adalah katalog iPhone untuk dijual (tabel produk): sku, model, kapasitas, warna, kondisi (Like New, Sangat Baik, Baik), battery health, harga jual, stok, dan status (aktif/nonaktif).&#xa;• Pengajuan adalah permintaan jual atau tukar tambah (tabel pengajuan): spesifikasi dan kondisi iPhone, foto, estimasi harga, harga final (diisi admin), lokasi dan jadwal pemeriksaan, serta status (Tinjau, Pemeriksaan, Disetujui, Siap dikirim, Selesai, Dibatalkan).&#xa;• Transaksi adalah riwayat jual, beli, dan tukar tambah (tabel transaksi) beserta nilai dan statusnya. Favorit menyimpan unit yang ditandai pengguna.&#xa;• HargaAcuan menyimpan harga dasar per model dan kapasitas; PenyesuaianHarga menyimpan pengurang harga untuk kondisi fisik dan battery health. Keduanya hanya diubah admin.&#xa;• AuthController mengelola User: login (email/Google), daftar, logout, dan pemulihan kata sandi.&#xa;• BeliController mengelola katalog: pencarian, filter, favorit, dan pesanan pembelian. JualController dan TukarTambahController mengelola pengajuan beserta jadwal pemeriksaan.&#xa;• EstimasiService menghitung estimasi: total = harga dasar - penyesuaian kondisi fisik - penyesuaian baterai (FR-25), dipakai oleh JualController dan TukarTambahController.&#xa;• AdminController mengelola produk, meninjau pengajuan, menetapkan harga final, mengubah status transaksi, dan mengelola harga acuan. LaporanController membaca data Transaksi untuk ringkasan bisnis dan ekspor laporan.&#xa;• Database menyimpan konfigurasi dan koneksi PDO ke MySQL/MariaDB. Semua data entity disimpan di sini. Atribut (FK) adalah foreign key ke entity terkait." style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1322" width="1860" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>